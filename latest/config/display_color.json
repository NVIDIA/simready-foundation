{
    "capability": {
        "id": "display_color",
        "version": "1.0.0",
        "requirements": [
            {
                "code": "DISP.002",
                "version": null,
                "name": "display-color-values",
                "compatibility": "open-usd",
                "tags": [
                    "correctness"
                ],
                "validator": "disp-002",
                "parameters": [],
                "metadata": {
                    "path": "capabilities/visualization/display_color/requirements/display-color-values.html",
                    "internal_path": "capabilities/visualization/display_color/requirements/display-color-values.md"
                },
                "message": "Authored display colour values must lie within the range a consumer can interpret.",
                "examples": [
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.4, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "constant interpolation, one element, components in range",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.216, 0.216, 0.216)] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "no colour space authored, so values are linear Rec.709 by default",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.216, 0.216, 0.216)] (\n        colorSpace = \"lin_rec709_scene\"\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "colour space authored explicitly on the attribute",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(1.8, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "component outside [0,1]",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.4, 0.4, 0.42), (0.1, 0.1, 0.1)] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "constant interpolation declared, two elements authored",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Xform \"Assembly\"\n{\n    color3f primvars:displayColor = (0.4, 0.4, 0.42) (\n        interpolation = \"constant\"\n    )\n\n    def Mesh \"bracket\"\n    {\n    }\n}"
                        },
                        "name": "a scalar color3f, not the declared color3f[]",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Xform \"Assembly\"\n{\n    color3d[] primvars:displayColor = [(0.4, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n\n    def Mesh \"bracket\"\n    {\n    }\n}"
                        },
                        "name": "color3d[], a precision variant of the declared color3f[]",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.4, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n    color3f[] primvars:displayColor.timeSamples = {\n        0: [(0.4, 0.4, 0.42)],\n        5: [(0.4, 9.5, 0.42)],\n    }\n}"
                        },
                        "name": "out of range at the second time sample",
                        "result": "failure"
                    }
                ]
            },
            {
                "code": "DISP.003",
                "version": null,
                "name": "display-opacity-values",
                "compatibility": "open-usd",
                "tags": [
                    "correctness"
                ],
                "validator": "disp-003",
                "parameters": [],
                "metadata": {
                    "path": "capabilities/visualization/display_color/requirements/display-opacity-values.html",
                    "internal_path": "capabilities/visualization/display_color/requirements/display-opacity-values.md"
                },
                "message": "Display opacity, where authored, must lie within its valid range and agree with its declared interpolation.",
                "examples": [
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.4, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "not authored, geometry is treated as fully opaque",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"window\"\n{\n    color3f[] primvars:displayColor = [(0.8, 0.85, 0.9)] (\n        interpolation = \"constant\"\n    )\n    float[] primvars:displayOpacity = [0.25] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "authored, in range",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"window\"\n{\n    color3f[] primvars:displayColor = [(0.8, 0.85, 0.9)] (\n        interpolation = \"constant\"\n    )\n    float[] primvars:displayOpacity = [1.5] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "opacity outside [0,1]",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"window\"\n{\n    color3f[] primvars:displayColor = [(0.8, 0.85, 0.9)] (\n        interpolation = \"constant\"\n    )\n    float primvars:displayOpacity = 0.25 (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "a scalar float, not the declared float[]",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"window\"\n{\n    color3f[] primvars:displayColor = [(0.8, 0.85, 0.9)] (\n        interpolation = \"constant\"\n    )\n    double[] primvars:displayOpacity = [0.25] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "double[], a precision variant of the declared float[]",
                        "result": "failure"
                    }
                ]
            },
            {
                "code": "DISP.001",
                "version": null,
                "name": "display-color-coverage",
                "compatibility": "open-usd",
                "tags": [
                    "correctness"
                ],
                "validator": "disp-001",
                "parameters": [],
                "metadata": {
                    "path": "capabilities/visualization/display_color/requirements/display-color-coverage.html",
                    "internal_path": "capabilities/visualization/display_color/requirements/display-color-coverage.md"
                },
                "message": "Every renderable geometry prim must resolve a display colour, authored on the prim or inherited from an ancestor.",
                "examples": [
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n    color3f[] primvars:displayColor = [(0.4, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n}"
                        },
                        "name": "authored on the Gprim",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Xform \"Assembly\"\n{\n    color3f[] primvars:displayColor = [(0.4, 0.4, 0.42)] (\n        interpolation = \"constant\"\n    )\n\n    def Mesh \"bracket\"\n    {\n    }\n}"
                        },
                        "name": "authored once on an ancestor, inherited by the geometry below",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Mesh \"bracket\"\n{\n}"
                        },
                        "name": "renderable mesh with no display colour on it or any ancestor",
                        "result": "failure"
                    }
                ]
            }
        ],
        "metadata": {
            "path": "capabilities/visualization/display_color/capability-display_color.html",
            "internal_path": "capabilities/visualization/display_color/capability-display_color.md"
        }
    }
}