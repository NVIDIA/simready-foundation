#usda 1.0
(
    defaultPrim = "Lidar"
    metersPerUnit = 1
    upAxis = "Z"
)

def OmniLidar "Lidar" (
    prepend apiSchemas = ["OmniSensorGenericLidarCoreAPI"]
)
{
    uint omni:sensor:Core:numberOfEmitters = 4
    uint omni:sensor:Core:numberOfChannels = 1
    uint omni:sensor:Core:scanRateBaseHz = 10
    token omni:sensor:Core:scanType = "SOLID_STATE"
    uint omni:sensor:Core:numberOfLines = 2
    uint[] omni:sensor:Core:numRaysPerLine = [2, 2]
    float omni:sensor:Core:nearRangeM = 0.05
    float omni:sensor:Core:farRangeM = 30
    float[] omni:sensor:Core:emitterState:s001:azimuthDeg   = [0, 90, 180, 270]
    float[] omni:sensor:Core:emitterState:s001:elevationDeg = [0,  0,   0,   0]
    uint[]  omni:sensor:Core:emitterState:s001:channelId    = [1,  1,   1,   1]
    uint[]  omni:sensor:Core:emitterState:s001:fireTimeNs   = [0, 10,  20,  30]
}
