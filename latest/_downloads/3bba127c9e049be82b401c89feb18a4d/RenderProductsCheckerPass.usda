#usda 1.0
(
    defaultPrim = "Root"
    endTimeCode = 90
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 90
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "Root"
{
    def Camera "RGB_Camera"
    {
        float2 clippingRange = (1, 10000000)
        float focalLength = 18.147562
        float focusDistance = 400
        double3 xformOp:rotateYXZ = (90, -0, 90)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ", "xformOp:scale"]
    }

    def OmniLidar "Lidar_3D" (
        prepend apiSchemas = ["OmniSensorGenericLidarCoreAPI"]
    )
    {
        float omni:sensor:Core:avgPowerW = 0.004
        float omni:sensor:Core:azimuthErrorMean = 0
        float omni:sensor:Core:azimuthErrorStd = 0
        float omni:sensor:Core:elevationErrorMean = 0
        float omni:sensor:Core:elevationErrorStd = 0
        float[] omni:sensor:Core:emitterState:s001:azimuthDeg = [0]
        uint[] omni:sensor:Core:emitterState:s001:channelId = [1]
        float[] omni:sensor:Core:emitterState:s001:distanceCorrectionM = [0]
        float[] omni:sensor:Core:emitterState:s001:elevationDeg = [1]
        uint[] omni:sensor:Core:emitterState:s001:fireTimeNs = [0]
        float[] omni:sensor:Core:emitterState:s001:focalDistM = [0]
        float[] omni:sensor:Core:emitterState:s001:focalSlope = [0]
        float[] omni:sensor:Core:emitterState:s001:horOffsetM = [0]
        float[] omni:sensor:Core:emitterState:s001:reportRateDiv = [0]
        float[] omni:sensor:Core:emitterState:s001:vertOffsetM = [0]
        float omni:sensor:Core:farRangeM = 30
        token omni:sensor:Core:intensityMappingType = "LINEAR"
        token omni:sensor:Core:intensityProcessing = "NORMALIZATION"
        uint omni:sensor:Core:maxReturns = 1
        float omni:sensor:Core:minReflectance = 0.1
        float omni:sensor:Core:nearRangeM = 0.05
        uint omni:sensor:Core:numberOfChannels = 1
        uint omni:sensor:Core:numberOfEmitters = 1
        uint omni:sensor:Core:pulseTimeNs = 5
        float omni:sensor:Core:rangeAccuracyM = 0.03
        float omni:sensor:Core:rangeResolutionM = 0.013
        token omni:sensor:Core:rayType = "IDEALIZED"
        uint omni:sensor:Core:reportRateBaseHz = 32000
        token omni:sensor:Core:rotationDirection = "CW"
        uint omni:sensor:Core:scanRateBaseHz = 10
        token omni:sensor:Core:scanType = "ROTARY"
        string omni:sensor:modelName = "RPLIDAR_S2E"
    }

    def OmniLidar "Lidar_2D" (
        prepend apiSchemas = ["OmniSensorGenericLidarCoreAPI"]
    )
    {
        float omni:sensor:Core:avgPowerW = 0.004
        float omni:sensor:Core:azimuthErrorMean = 0
        float omni:sensor:Core:azimuthErrorStd = 0
        float omni:sensor:Core:elevationErrorMean = 0
        float omni:sensor:Core:elevationErrorStd = 0
        float[] omni:sensor:Core:emitterState:s001:azimuthDeg = [0]
        uint[] omni:sensor:Core:emitterState:s001:channelId = [1]
        float[] omni:sensor:Core:emitterState:s001:distanceCorrectionM = [0]
        float[] omni:sensor:Core:emitterState:s001:elevationDeg = [0]
        uint[] omni:sensor:Core:emitterState:s001:fireTimeNs = [0]
        float[] omni:sensor:Core:emitterState:s001:focalDistM = [0]
        float[] omni:sensor:Core:emitterState:s001:focalSlope = [0]
        float[] omni:sensor:Core:emitterState:s001:horOffsetM = [0]
        float[] omni:sensor:Core:emitterState:s001:reportRateDiv = [0]
        float[] omni:sensor:Core:emitterState:s001:vertOffsetM = [0]
        float omni:sensor:Core:farRangeM = 30
        token omni:sensor:Core:intensityMappingType = "LINEAR"
        token omni:sensor:Core:intensityProcessing = "NORMALIZATION"
        uint omni:sensor:Core:maxReturns = 1
        float omni:sensor:Core:minReflectance = 0.1
        float omni:sensor:Core:nearRangeM = 0.05
        uint omni:sensor:Core:numberOfChannels = 1
        uint omni:sensor:Core:numberOfEmitters = 1
        uint omni:sensor:Core:pulseTimeNs = 5
        float omni:sensor:Core:rangeAccuracyM = 0.03
        float omni:sensor:Core:rangeResolutionM = 0.013
        token omni:sensor:Core:rayType = "IDEALIZED"
        uint omni:sensor:Core:reportRateBaseHz = 32000
        token omni:sensor:Core:rotationDirection = "CW"
        uint omni:sensor:Core:scanRateBaseHz = 10
        token omni:sensor:Core:scanType = "ROTARY"
        string omni:sensor:modelName = "RPLIDAR_S2E"
    }
}

def Scope "Render"
{
    def RenderProduct "RGB_CameraRp"
    {
        rel camera = </Root/RGB_Camera>
        rel orderedVars = [
            </Render/RGB_CameraRp/LdrColor>,
            </Render/RGB_CameraRp/DepthLinearized>,
            </Render/RGB_CameraRp/Normals>,
        ]
        uniform int2 resolution = (1920, 1200)

        def RenderVar "LdrColor"
        {
            uniform string sourceName = "LdrColor"
        }

        def RenderVar "DepthLinearized"
        {
            uniform string sourceName = "DepthLinearized"
        }

        def RenderVar "Normals"
        {
            uniform string sourceName = "normals"
        }
    }

    def RenderProduct "Lidar_3DRp"
    {
        rel camera = </Root/Lidar_3D>
        rel orderedVars = </Render/Lidar_3DRp/GenericModelOutput>
        uniform int2 resolution = (1080, 720)

        def RenderVar "GenericModelOutput"
        {
            uniform string sourceName = "GenericModelOutput"
        }
    }

    def RenderProduct "Lidar_2DRp"
    {
        rel camera = </Root/Lidar_2D>
        rel orderedVars = </Render/Lidar_2DRp/GenericModelOutput>
        uniform int2 resolution = (1080, 720)

        def RenderVar "GenericModelOutput"
        {
            uniform string sourceName = "GenericModelOutput"
        }
    }

    def "OmniverseKit"
    {
        def "HydraTextures"
        {
            def RenderProduct "omni_kit_widget_viewport_ViewportTexture_0"
            {
            }
        }
    }
}
