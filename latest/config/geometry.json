                ],
                "validator": null,
                "parameters": [],
                "metadata": {
                    "path": "capabilities/visualization/geometry/requirements/asset-origin-positioning.html",
                    "internal_path": "capabilities/visualization/geometry/requirements/asset-origin-positioning.md"
                },
                "message": "Geometry shall be defined as such that the asset is correctly positioned and oriented at the origin (0,0,0).",
                "examples": [
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "#usda 1.0\n\ndef Xform \"Table_Valid\" ()\n{\n    float3 xformOp:translate = (0, 0, 0)\n    float3 xformOp:rotateXYZ = (0, 0, 0)\n    float3 xformOp:scale = (1, 1, 1)\n    uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:rotateXYZ\", \"xformOp:scale\"]\n\n    def Cube \"TableTop\" {\n        float3 xformOp:translate = (0, 0, 0.6)\n        float3 xformOp:scale = (1, 1, 0.2)\n        uniform token[] xformOpOrder = [\"xformOp:translate\", \"xformOp:scale\"]\n    }\n}"
                        },
                        "name": "Asset positioned correctly at origin",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "#usda 1.0\n\ndef Xform \"Table_Invalid\" (\n)\n{\n    float3 xformOp:translate = (0, 0, 0.6)  # Asset offset from origin by default\n    uniform token[] xformOpOrder = [\"xformOp:translate\"]\n\n    def Cube \"TableTop\" {\n        float3 xformOp:scale = (1, 1, 0.2)\n        uniform token[] xformOpOrder = [\"xformOp:scale\"]\n    }\n}"
                        },
                        "name": "Asset with non-identity default transforms",
                        "result": "failure"
