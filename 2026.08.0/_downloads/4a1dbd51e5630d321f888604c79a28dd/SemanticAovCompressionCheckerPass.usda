#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float2 clippingRange = (0.1, 100)
        float focalLength = 18.147562
        float focusDistance = 400
        double3 xformOp:rotateYXZ = (83.37361145019531, 0, 1.5027636289596558)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.3511944722203288, -8.76326062508951, 1.0947524034228595)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ", "xformOp:scale"]
    }

    def Cube "Box" (
        prepend apiSchemas = ["SemanticsAPI:Semantics"]
    )
    {
        double size = 0.8
        string semantic:Semantics:params:semanticData = "box"
        string semantic:Semantics:params:semanticType = "class"
        double3 xformOp:translate = (-1, -3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball" (
        prepend apiSchemas = ["SemanticsAPI:Semantics"]
    )
    {
        double radius = 0.5
        string semantic:Semantics:params:semanticData = "ball"
        string semantic:Semantics:params:semanticType = "class"
        double3 xformOp:translate = (0.5, -3, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Pillar" (
        prepend apiSchemas = ["SemanticsAPI:Semantics"]
    )
    {
        double height = 1.5
        double radius = 0.3
        string semantic:Semantics:params:semanticData = "pillar"
        string semantic:Semantics:params:semanticType = "class"
        double3 xformOp:translate = (1.5, -3, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderProduct "CameraRp"
    {
        rel camera = </World/Camera>
        rel orderedVars = [
            </Render/CameraRp/LdrColor>,
            </Render/CameraRp/SemanticSegmentation>,
            </Render/CameraRp/SemanticBoundingBox2DLoose>,
        ]
        uniform int2 resolution = (1920, 1080)

        def RenderVar "LdrColor"
        {
            uniform string sourceName = "LdrColor"
            uniform string srtx:compression:type = "hevc" (
                allowedTokens = ["hevc", "h264", "av1", "blosc"]
            )
        }

        def RenderVar "SemanticSegmentation"
        {
            uniform string sourceName = "SemanticSegmentation"
            uniform string srtx:compression:type = "blosc" (
                allowedTokens = ["hevc", "h264", "av1", "blosc"]
            )
        }

        def RenderVar "SemanticBoundingBox2DLoose"
        {
            uniform string sourceName = "SemanticBoundingBox2DLoose"
            uniform string srtx:compression:type = "blosc" (
                allowedTokens = ["hevc", "h264", "av1", "blosc"]
            )
        }
    }
}
