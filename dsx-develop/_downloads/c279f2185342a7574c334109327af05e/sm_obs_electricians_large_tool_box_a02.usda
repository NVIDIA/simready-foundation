def Xform "Toolbox" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    kind = "component"
    variants = {
        string MeshVariant_base = "base_var_001"
        string MeshVariant_lid = "lid_var_001"
        string MuJoCo = "Disabled"
        string Newton = "Disabled"
        string PhysX = "Disabled"
        string Representation = "Original"
    }
    prepend variantSets = ["Representation", "MeshVariant_base", "MeshVariant_lid", "PhysX", "Newton", "MuJoCo"]
)
{
    def Xform "Base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Toolbox/PhysicsMaterials/physics_mat_opaque__plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physics:mass = 1.2
        bool physics:rigidBodyEnabled = 1

        def Cube "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.47000003, 0.25097048, 0.2154652)
            double3 xformOp:translate = (2.2351741790771484e-8, 0.006092224270105362, 0.10773258743460179)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "Lid" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Toolbox/PhysicsMaterials/physics_mat_opaque__plastic> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float physics:mass = 0.8
        bool physics:rigidBodyEnabled = 1
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate:pivot = (0, 0.12863185, 0.17159575)
        uniform token[] xformOpOrder = ["xformOp:translate:pivot", "xformOp:rotateXYZ", "!invert!xformOp:translate:pivot"]

        def Cube "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.47000003, 0.25097078, 0.11568993)
            double3 xformOp:translate = (0.0000079423189163208, 0.006091408431529999, 0.22101804614067078)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Scope "PhysicsMaterials"
    {
        def Material "physics_mat_opaque__plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:density = 950
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0.4
            float physics:staticFriction = 0.4
        }
    }

    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "lid_joint"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </Toolbox/Base>
            rel physics:body1 = </Toolbox/Lid>
            float physics:breakForce = inf
            float physics:breakTorque = inf
            bool physics:collisionEnabled = 0
            uniform bool physics:excludeFromArticulation = 0
            bool physics:jointEnabled = 1
            point3f physics:localPos0 = (0, 0.12863185, 0.17159575)
            point3f physics:localPos1 = (0, 0.12863185, 0.17159575)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -150
            float physics:upperLimit = 0
        }
    }
    variantSet "MeshVariant_base" = {
        "base_var_001" (
            prepend payload = @./wrappers/base_var_001_cell.usda@
        ) {

        }
