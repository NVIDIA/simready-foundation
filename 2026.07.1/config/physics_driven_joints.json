                    "internal_path": "capabilities/physics_bodies/physics_driven_joints/requirements/mujoco-joint-api.md"
                },
                "message": "MuJoCo driven joints must use standard `UsdPhysics.Joint` prims with `MjcJointAPI` applied to every non-fixed articulation joint.",
                "examples": []
            },
            {
                "code": "DJ.011",
                "version": null,
                "name": "no-articulation-loops",
                "compatibility": "open-usd",
                "tags": [
                    "essential"
                ],
                "validator": "CheckStage",
                "parameters": [],
                "metadata": {
                    "path": "capabilities/physics_bodies/physics_driven_joints/requirements/no-articulation-loops.html",
                    "internal_path": "capabilities/physics_bodies/physics_driven_joints/requirements/no-articulation-loops.md"
                },
                "message": "The articulation must have no loops and at most one joint between any two bodies. Only joints that participate in the articulation are checked; joints with `physics:excludeFromArticulation = true` are ignored.",
                "examples": [
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Xform \"Body_A\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef Xform \"Body_B\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef Xform \"Body_C\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef PhysicsRevoluteJoint \"Joint_1\"\n{\n    rel physics:body0 = </Body_A>\n    rel physics:body1 = </Body_B>\n}\n\ndef PhysicsRevoluteJoint \"Joint_2\"\n{\n    rel physics:body0 = </Body_B>\n    rel physics:body1 = </Body_C>\n}\n\ndef PhysicsRevoluteJoint \"Joint_3\"\n{\n    rel physics:body0 = </Body_C>\n    rel physics:body1 = </Body_A>\n}"
                        },
                        "name": "Simple loop (cycle)",
                        "result": "failure"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Xform \"Body_A\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef Xform \"Body_B\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef Xform \"Body_C\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef PhysicsRevoluteJoint \"Joint_1\"\n{\n    rel physics:body0 = </Body_A>\n    rel physics:body1 = </Body_B>\n}\n\ndef PhysicsRevoluteJoint \"Joint_2\"\n{\n    rel physics:body0 = </Body_B>\n    rel physics:body1 = </Body_C>\n}\n\ndef PhysicsRevoluteJoint \"Joint_3\"\n{\n    rel physics:body0 = </Body_C>\n    rel physics:body1 = </Body_A>\n    bool physics:excludeFromArticulation = 1    \n}"
                        },
                        "name": "Simple chain (tree)",
                        "result": "success"
                    },
                    {
                        "snippet": {
                            "language": "usd",
                            "content": "def Xform \"Body_A\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef Xform \"Body_B\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef Xform \"Body_C\" (\n    prepend apiSchemas = [\"PhysicsRigidBodyAPI\"]\n)\n{\n}\n\ndef PhysicsRevoluteJoint \"Joint_1\"\n{\n    rel physics:body0 = </Body_A>\n    rel physics:body1 = </Body_B>\n}\n\ndef PhysicsRevoluteJoint \"Joint_2\"\n{\n    rel physics:body0 = </Body_B>\n    rel physics:body1 = </Body_C>\n    bool physics:excludeFromArticulation = 1\n}\n\ndef PhysicsRevoluteJoint \"Joint_3\"\n{\n    rel physics:body0 = </Body_C>\n    rel physics:body1 = </Body_A>\n}"
                        },
                        "name": "Also valid: Simple chain (tree)",
                        "result": "success"
                    }
                ]
            },
