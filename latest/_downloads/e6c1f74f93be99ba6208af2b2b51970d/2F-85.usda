def Xform "Robotiq_2F_85" (
    kind = "component"
    prepend references = @./payloads/base.usda@
    variants = {
        string MuJoCo = "Disabled"
        string Newton = "Disabled"
        string PhysX = "Disabled"
    }
    prepend variantSets = ["PhysX", "Newton", "MuJoCo"]
)
{
    string isaac:namespace (
        displayName = "Namespace"
        doc = "Namespace of the prim in Isaac Sim"
    )
    custom rel isaac:physics:robotJoints = [
        </Robotiq_2F_85/root_joint>,
        </Robotiq_2F_85/Joints/finger_joint>,
        </Robotiq_2F_85/Joints/right_outer_knuckle_joint>,
        </Robotiq_2F_85/Joints/right_outer_finger_joint>,
        </Robotiq_2F_85/Joints/right_inner_finger_joint>,
        </Robotiq_2F_85/Joints/right_inner_finger_knuckle_joint>,
        </Robotiq_2F_85/Joints/left_outer_finger_joint>,
        </Robotiq_2F_85/Joints/left_inner_finger_knuckle_joint>,
        </Robotiq_2F_85/Joints/left_inner_finger_joint>,
    ]
    custom uniform token isaac:robotType = "End Effector"
    quatd xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    over "base_link"
    {
        def Xform "gripper_01" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
            custom float gripper_maxOpening = 0.085
            custom float gripper_maxPayload = 5
            string isaac:Description = "Parallel-jaw grasp center between the two finger pads (Robotiq 2F-85)."
            custom token simready:attachment:socketType = "Gripper"
            quatd xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0.16)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def BasisCurves "gripper_forward_axis"
            {
                int[] curveVertexCounts = [2]
                float3[] extent = [(0, 0, 0), (0, 0, 0.05)]
                point3f[] points = [(0, 0, 0), (0, 0, 0.05)]
                uniform token purpose = "guide"
                uniform token type = "linear"
            }

            def BasisCurves "gripper_grip_line"
            {
                int[] curveVertexCounts = [2]
                float3[] extent = [(-0.0425, 0, 0), (0.0425, 0, 0)]
                point3f[] points = [(-0.0425, 0, 0), (0.0425, 0, 0)]
                uniform token purpose = "guide"
                uniform token type = "linear"
            }
        }
    }
    variantSet "PhysX" = {
        "Disabled" {

        }
        "Enabled" (
            prepend payload = @./runnables/physics/physx.usda@
        ) {

        }
    }
    variantSet "Newton" = {
        "Disabled" {

        }
        "Enabled" (
            prepend payload = @./runnables/physics/newton.usda@
        ) {

        }
    }
    variantSet "MuJoCo" = {
        "Disabled" {

        }
        "Enabled" (
            prepend payload = @./runnables/physics/mujoco.usda@
        ) {

        }
    }
}
