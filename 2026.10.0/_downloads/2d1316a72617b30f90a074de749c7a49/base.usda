#usda 1.0
(
    defaultPrim = "ur10"
    metersPerUnit = 1
    subLayers = [
        @./robot.usda@,
        @./Physics/physics.usda@,
        @./materials.usda@,
        @./geometries.usd@
    ]
    upAxis = "Z"
)

over "ur10"
{
    over "wrist_3_link"
    {
        def Xform "tool_mount_01" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
            string isaac:Description = "UR10 manipulator flange, ISO 9409-1-50-4-M6."
            uniform token isaac:forwardAxis = "Z"
            custom uniform token simready:mate:domain = "mechanical"
            custom uniform token simready:mate:mechanical:interface = "ISO-9409-1-50-4-M6"
            custom uniform token simready:mate:mechanical:kind = "ManipulatorFlange"
            custom float simready:mate:mechanical:maxPayload = 10
            custom uniform token simready:mate:role = "Socket"
            quatd xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}

